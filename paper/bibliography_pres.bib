@article{liDeepUNetDeepFully2018,
  title = {{{DeepUNet}}: {{A Deep Fully Convolutional Network}} for {{Pixel-Level Sea-Land Segmentation}}},
  shorttitle = {{{DeepUNet}}},
  author = {Li, R. and Liu, W. and Yang, L. and Sun, S. and Hu, W. and Zhang, F. and Li, W.},
