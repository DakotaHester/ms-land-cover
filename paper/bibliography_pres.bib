@article{yuanShiftPoolingPSPNet2022,
  title = {Shift {{Pooling PSPNet}}: {{Rethinking PSPNet}} for {{Building Extraction}} in {{Remote Sensing Images}} from {{Entire Local Feature Pooling}}},
