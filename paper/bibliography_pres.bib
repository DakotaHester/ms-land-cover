  year = {2024},
  month = jan,
  journal = {Procedia Computer Science},
  series = {9th {{International Conference}} on {{Computer Science}} and {{Computational Intelligence}} 2024 ({{ICCSCI}} 2024)},
  volume = {245},
  pages = {538--547},
  issn = {1877-0509},
  doi = {10.1016/j.procs.2024.10.280},
  urldate = {2025-07-10},
  abstract = {Land cover refers to an observable physical surface and has various applications, such as in urban planning. Land cover segmentation is the process of simplifying the color range in the original image into specific land cover categories, aiming to facilitate further analysis. However, this segmentation process still poses significant challenges in terms of time and cost. Therefore, this study proposes a solution by applying deep learning models based on Convolutional Neural Network (CNN) and Transformer to perform segmentation quickly and automatically. In this research, a comparison is made between several models, namely UNet, UNet++, DeepLabV3+, UNetFormer, and UNetFormer++. UNetFormer++ is a proposed modification to the UNetFormer architecture by adding nested skip connections, as implemented in UNet++. The results show that the model that uses Transformer has better performance than the model that only uses CNN. The UNetFormer++ model achieves the highest value in validation and test sets with an average Dice value of 79.82\% and an average IoU value of 72.18\%.},
  keywords = {CNN,deep learning,Land cover,READ,semantic segmentation,Tramsformer,UNetFormer++},
  annotation = {0 citations (Crossref) [2025-07-10]},
  file = {/Users/dak/Zotero/storage/7JVZE4XB/Pratama et al. - 2024 - Enhanced aerial image segmentation for land cover .pdf;/Users/dak/Zotero/storage/L2ERXT72/S1877050924030886.html}
}

