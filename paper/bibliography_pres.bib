@article{zhouCNNBasedLandCover2019,
  title = {{{CNN-Based Land Cover Classification Combining Stratified Segmentation}} and {{Fusion}} of {{Point Cloud}} and {{Very High-Spatial Resolution Remote Sensing Image Data}}},
  author = {Zhou, Keqi and Ming, Dongping and Lv, Xianwei and Fang, Ju and Wang, Min},
  year = {2019},
