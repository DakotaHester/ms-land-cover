  author = {Hamaguchi, R. and Fujita, A. and Nemoto, K. and Imaizumi, T. and Hikosaka, S.},
  year = {2018},
  volume = {2018-January},
  pages = {1442--1450},
  doi = {10.1109/WACV.2018.00162},
  abstract = {Thanks to recent advances in CNNs, solid improvements have been made in semantic segmentation of high resolution remote sensing imagery. However, most of the previous works have not fully taken into account the specific difficulties that exist in remote sensing tasks. One of such difficulties is that objects are small and crowded in remote sensing imagery. To tackle with this challenging task we have proposed a novel architecture called local feature extraction (LFE) module attached on top of dilated front-end module. The LFE module is based on our findings that aggressively increasing dilation factors fails to aggregate local features due to sparsity of the kernel, and detrimental to small objects. The proposed LFE module solves this problem by aggregating local features with decreasing dilation factor. We tested our network on three remote sensing datasets and acquired remarkably good results for all datasets especially for small objects. {\copyright} 2018 IEEE.},
  annotation = {152 citations (Crossref) [2024-10-11]},
