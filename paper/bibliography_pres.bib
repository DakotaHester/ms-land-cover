@incollection{verburgModelingLandUseLandCover2006,
  title = {Modeling {{Land-Use}} and {{Land-Cover Change}}},
  booktitle = {Land-{{Use}} and {{Land-Cover Change}}: {{Local Processes}} and {{Global Impacts}}},
  author = {Verburg, Peter H. and Kok, Kasper and Pontius, Robert Gilmore and Veldkamp, A.},
  editor = {Lambin, Eric F. and Geist, Helmut},
  year = {2006},
  pages = {117--135},
  publisher = {Springer},
