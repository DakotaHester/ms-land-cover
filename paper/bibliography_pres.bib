@article{otukeiLandCoverChange2010,
  title = {Land Cover Change Assessment Using Decision Trees, Support Vector Machines and Maximum Likelihood Classification Algorithms},
  author = {Otukei, J. R. and Blaschke, T.},
  year = {2010},
  month = feb,
  journal = {International Journal of Applied Earth Observation and Geoinformation},
  series = {Supplement {{Issue}} on "{{Remote Sensing}} for {{Africa}} -- {{A Special Collection}} from the {{African Association}} for {{Remote Sensing}} of the {{Environment}} ({{AARSE}})"},
