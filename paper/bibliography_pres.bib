@article{wangEmpiricalStudyRemote2023a,
  title = {An {{Empirical Study}} of {{Remote Sensing Pretraining}}},
  author = {Wang, Di and Zhang, Jing and Du, Bo and Xia, Gui-Song and Tao, Dacheng},
