@article{mingScaleParameterSelection2015,
  title = {Scale Parameter Selection by Spatial Statistics for {{GeOBIA}}: {{Using}} Mean-Shift Based Multi-Scale Segmentation as an Example},
  shorttitle = {Scale Parameter Selection by Spatial Statistics for {{GeOBIA}}},
  author = {Ming, Dongping and Li, Jonathan and Wang, Junyi and Zhang, Min},
