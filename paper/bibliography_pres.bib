  author = {Mirzadeh, Iman and Alizadeh, Keivan and Mehta, Sachin and Mundo, Carlo C. Del and Tuzel, Oncel and Samei, Golnoosh and Rastegari, Mohammad and Farajtabar, Mehrdad},
