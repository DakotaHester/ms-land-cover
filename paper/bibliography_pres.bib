  shorttitle = {{{BAS}}{$^{4}$}{{Net}}},
  author = {Sun, Xian and Shi, Aijun and Huang, Hai and Mayer, Helmut},
  year = {2020},
  journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
  volume = {13},
  pages = {5398--5413},
