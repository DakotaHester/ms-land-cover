@article{gadeAdvancementsUAVRemote2025,
  title = {Advancements in {{UAV}} Remote Sensing for Agricultural Yield Estimation: {{A}} Systematic Comprehensive Review of Platforms, Sensors, and Data Analytics},
  shorttitle = {Advancements in {{UAV}} Remote Sensing for Agricultural Yield Estimation},
  author = {Gade, Shubham Anil and Madolli, Mallappa Jadiyappa and Garc{\'i}a-Caparr{\'o}s, Pedro and Ullah, Hayat and {Cha-um}, Suriyan and Datta, Avishek and Himanshu, Sushil Kumar},
  year = {2025},
