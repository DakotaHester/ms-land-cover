@article{liuSemanticSegmentationMultisensor2019,
  title = {Semantic Segmentation of Multisensor Remote Sensing Imagery with Deep {{ConvNets}} and Higher-Order Conditional Random Fields},
  author = {Liu, Yansong and Piramanayagam, Sankaranarayanan and Monteiro, Sildomar T. and Saber, Eli},
