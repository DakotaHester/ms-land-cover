@article{yuanAutomatedArtificialNeural2009,
  title = {An {{Automated Artificial Neural Network System}} for {{Land Use}}/{{Land Cover Classification}} from {{Landsat TM Imagery}}},
  author = {Yuan, Hui and Van Der Wiele, Cynthia F. and Khorram, Siamak},
  year = {2009},
