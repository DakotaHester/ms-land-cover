@article{liABCNetAttentiveBilateral2021,
  title = {{{ABCNet}}: {{Attentive}} Bilateral Contextual Network for Efficient Semantic Segmentation of {{Fine-Resolution}} Remotely Sensed Imagery},
  shorttitle = {{{ABCNet}}},
  author = {Li, Rui and Zheng, Shunyi and Zhang, Ce and Duan, Chenxi and Wang, Libo and Atkinson, Peter M.},
  year = {2021},
  month = nov,
  journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
