@article{zhouTrainingDataSelection2020,
  title = {Training {{Data Selection}} for {{Annual Land Cover Classification}} for the {{Land Change Monitoring}}, {{Assessment}}, and {{Projection}} ({{LCMAP}}) {{Initiative}}},
  author = {Zhou, Qiang and Tollerud, Heather and Barber, Christopher and Smith, Kelcy and Zelenak, Daniel},
