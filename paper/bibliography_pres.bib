  annotation = {1033 citations (Crossref) [2024-10-07]},
  file = {/Users/dak/Zotero/storage/V2WFYC4W/Guo et al. - 2022 - Attention mechanisms in computer vision A survey.pdf}
}

@article{guoLearnableGatedConvolutional2019a,
