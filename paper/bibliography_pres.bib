@article{gePrinciplesMethodsScaling2019,
  title = {Principles and Methods of Scaling Geospatial {{Earth}} Science Data},
  author = {Ge, Yong and Jin, Yan and Stein, Alfred and Chen, Yuehong and Wang, Jianghao and Wang, Jinfeng and Cheng, Qiuming and Bai, Hexiang and Liu, Mengxiao and Atkinson, Peter M.},
  year = {2019},
