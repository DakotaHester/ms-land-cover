  booktitle = {Umweltinformation F\{{\textbackslash}"u\}r {{Planung}}, {{Politik}} Und \{{\textbackslash}"\vphantom\}{{O}}\vphantom\{\}ffentlichkeit / {{Environmental Information}} for {{Planning}}, {{Politics}} and the {{Public}}},
