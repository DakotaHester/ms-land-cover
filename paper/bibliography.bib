}

@article{hansenReviewLargeArea2012,
  title = {A Review of Large Area Monitoring of Land Cover Change Using {{Landsat}} Data},
  author = {Hansen, Matthew C. and Loveland, Thomas R.},
  year = {2012},
  month = jul,
  journal = {Remote Sensing of Environment},
  series = {Landsat {{Legacy Special Issue}}},
  volume = {122},
