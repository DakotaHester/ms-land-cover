@misc{zhaoPyramidSceneParsing2017a,
  title = {Pyramid {{Scene Parsing Network}}},
  author = {Zhao, Hengshuang and Shi, Jianping and Qi, Xiaojuan and Wang, Xiaogang and Jia, Jiaya},
