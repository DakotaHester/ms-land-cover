  langid = {english},
  keywords = {Ecological modelling,Environmental impact},
  annotation = {304 citations (Crossref) [2024-09-05]},
  file = {C:\Users\dh2306\OneDrive - Mississippi State University\Zotero\Brown et al. - 2022 - Dynamic World, Near real-time global 10 m land use land cover mapping.pdf}
}

