@article{chengSurveyObjectDetection2016,
  title = {A Survey on Object Detection in Optical Remote Sensing Images},
  author = {Cheng, G. and Han, J.},
  year = 2016,
  journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
  volume = {117},
  pages = {11--28},
  doi = {10.1016/j.isprsjprs.2016.03.014},
  abstract = {Object detection in optical remote sensing images, being a fundamental but challenging problem in the field of aerial and satellite image analysis, plays an important role for a wide range of applications and is receiving significant attention in recent years. While enormous methods exist, a deep review of the literature concerning generic object detection is still lacking. This paper aims to provide a review of the recent progress in this field. Different from several previously published surveys that focus on a specific object class such as building and road, we concentrate on more generic object categories including, but are not limited to, road, building, tree, vehicle, ship, airport, urban-area. Covering about 270 publications we survey (1) template matching-based object detection methods, (2) knowledge-based object detection methods, (3) object-based image analysis (OBIA)-based object detection methods, (4) machine learning-based object detection methods, and (5) five publicly available datasets and three standard evaluation metrics. We also discuss the challenges of current studies and propose two promising research directions, namely deep learning-based feature representation and weakly supervised learning-based geospatial object detection. It is our hope that this survey will be beneficial for the researchers to have better understanding of this research field. {\copyright} 2016 International Society for Photogrammetry and Remote Sensing, Inc. (ISPRS).},
  keywords = {Deep learning,Machine learning,Object detection,Object-based image analysis (OBIA),Optical remote sensing images,Template matching,Weakly supervised learning},
  annotation = {1023 citations (Crossref) [2024-10-05]},
  file = {C\:\\Users\\dh2306\\OneDrive - Mississippi State University\\Zotero\\Cheng and Han - 2016 - A survey on object detection in optical remote sensing images.pdf;C\:\\Users\\dh2306\\Zotero\\storage\\SJB7Q35M\\display.html}
