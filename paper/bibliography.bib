@article{wangScaleSelfadaptingSegmentation2018,
  title = {A Scale Self-Adapting Segmentation Approach and Knowledge Transfer for Automatically Updating Land Use/Cover Change Databases Using High Spatial Resolution Images},
  author = {Wang, Zhihua and Yang, Xiaomei and Lu, Chen and Yang, Fengshuo},
