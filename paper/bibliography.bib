  shorttitle = {Deep Learning in Remote Sensing Applications},
  author = {Ma, Lei and Liu, Yu and Zhang, Xueliang and Ye, Yuanxin and Yin, Gaofei and Johnson, Brian Alan},
  year = {2019},
