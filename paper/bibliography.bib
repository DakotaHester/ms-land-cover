  shorttitle = {A Global Land-Cover Validation Data Set, {{II}}},
  author = {Stehman, Stephen V. and Olofsson, Pontus and Woodcock, Curtis E. and Herold, Martin and Friedl, Mark A.},
  year = 2012,
