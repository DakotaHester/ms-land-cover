@article{douzasImbalancedLearningLand2019,
  title = {Imbalanced {{Learning}} in {{Land Cover Classification}}: {{Improving Minority Classes}}' {{Prediction Accuracy Using}} the {{Geometric SMOTE Algorithm}}},
