@article{liImpactsSpatialResolutions2022,
  title = {The Impacts of Spatial Resolutions on Global Urban-Related Change Analyses and Modeling},
  author = {Li, Xia and Chen, Guangzhao and Zhang, Yongping and Yu, Le and Du, Zhenrong and Hu, Guohua and Liu, Xiaojuan},
