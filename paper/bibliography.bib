@article{tewkesburyCriticalSynthesisRemotely2015,
  title = {A Critical Synthesis of Remotely Sensed Optical Image Change Detection Techniques},
  author = {Tewkesbury, Andrew P. and Comber, Alexis J. and Tate, Nicholas J. and Lamb, Alistair and Fisher, Peter F.},
  year = 2015,
