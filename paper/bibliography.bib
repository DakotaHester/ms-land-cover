  author = {Zhao, Zhewen and Islam, Fakhrul and Waseem, Liaqat Ali and Tariq, Aqil and Nawaz, Muhammad and Islam, Ijaz Ul and Bibi, Tehmina and Rehman, Nazir Ur and Ahmad, Waqar and Aslam, Rana Waqar and Raza, Danish and Hatamleh, Wesam Atef},
  year = 2024,
