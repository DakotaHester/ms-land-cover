@article{abdollahiEnsembleArchitectureDeep2022,
  title = {An Ensemble Architecture of Deep Convolutional {{Segnet}} and {{Unet}} Networks for Building Semantic Segmentation from High-Resolution Aerial Images},
  author = {Abdollahi, Arnick and Pradhan, Biswajeet and Alamri, Abdullah M.},
  year = 2022,
