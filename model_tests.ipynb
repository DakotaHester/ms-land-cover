    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from glob import glob\n",
    "from src.mslandcover.metrics import psnr, ssim\n",
    "from src.mslandcover.data.transforms import normalize\n",
    "\n",
    "\n",
    "file_list = glob('./data/splits/test/input/*.tif')\n",
    "\n",
    "mean = load_pth('./weights/pretrain_mean.pth')\n",
    "std = load_pth('./weights/pretrain_std.pth')\n",
    "\n",
    "def unnormalize(X, mean=mean, std=std):\n",
    "    X = X.permute(0, 2, 3, 1)\n",
    "    X = X * std + mean\n",
    "    return X.squeeze().detach().numpy()\n",
    "\n",
    "def stretch(X, vmin=torch.Tensor([0, 0, 0]), vmax=torch.Tensor([1, 1, 1]), contrast_adjust_constant=0.0):\n",
    "    vmin_adj = vmin + contrast_adjust_constant\n",
    "    vmax_adj = vmax - contrast_adjust_constant\n",
    "    X = np.clip(X, vmin_adj, vmax_adj)\n",
    "    X = (X - (vmin_adj)) / ((vmax_adj) - (vmin_adj))\n",
    "    return X\n",
    "\n",
    "for i in range(10):\n",
    "    with rio.open(file_list[i]) as src:\n",
    "        X = src.read() / 255.0\n",
    "    \n",
    "    vmin = np.min(X, axis=(1, 2))\n",
    "    vmax = np.max(X, axis=(1, 2))\n",
    "\n",
    "    fig, axes = plt.subplots(1, 4, figsize=(20, 5))\n",
    "    \n",
    "    X = torch.from_numpy(X.transpose(1, 2, 0)).unsqueeze(0).float()\n",
    "    axes[0].imshow(X.squeeze())\n",
    "    axes[0].set_title('Input')\n",
    "    axes[0].axis('off')\n",
    "    \n",
    "    # X_norm = X.permute(0, 2, 3, 1)\n",
    "    # X_norm = (X - mean) / std\n",
    "    X_norm = X.clone()\n",
    "    X_norm = X_norm.permute(0, 3, 1, 2)\n",
    "\n",
    "    # X_norm = X\n",
    "    y_norm = resnet_ae(X_norm)\n",
    "    psnr_val = psnr(X_norm, y_norm, reduction='mean')\n",
    "    ssim_val = ssim(X_norm, y_norm, reduction='mean')\n",
    "    y = unnormalize(y_norm * 2)\n",
    "    # y = stretch(y, vmin=vmin, vmax=vmax)\n",
    "    \n",
    "    axes[1].imshow(y)\n",
    "    axes[1].set_title(f'Predicted\\nPSNR: {psnr_val:.2f}, SSIM: {ssim_val:.2f}')\n",
    "    axes[1].axis('off')\n",
    "    \n",
    "    y_norm = resnet_ae_randinit(X_norm)\n",
    "    psnr_val = psnr(X_norm, y_norm, reduction='mean')\n",
    "    ssim_val = ssim(X_norm, y_norm, reduction='mean')\n",
    "    y = unnormalize(y_norm * 2)\n",
    "    \n",
    "    axes[2].imshow(y)\n",
    "    axes[2].set_title(f'Predicted (randinit)\\nPSNR: {psnr_val:.2f}, SSIM: {ssim_val:.2f}')\n",
    "    axes[2].axis('off')\n",
    "    \n",
    "    y_norm = resnet_ae_inet(X_norm)\n",
    "    psnr_val = psnr(X_norm, y_norm, reduction='mean')\n",
    "    ssim_val = ssim(X_norm, y_norm, reduction='mean')\n",
    "    y = unnormalize(y_norm * 2)\n",
    "    \n",
    "    axes[3].imshow(y)\n",
    "    axes[3].set_title(f'Predicted (inet)\\nPSNR: {psnr_val:.2f}, SSIM: {ssim_val:.2f}')\n",
    "    axes[3].axis('off')\n",
    "\n",
    "    \n",
    "    # plt.suptitle(f'PSNR: {psnr_val:.2f}, SSIM: {ssim_val:.2f}')\n",
    "    plt.show()\n"
   ]
